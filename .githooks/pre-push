#!/usr/bin/env bash
set -euo pipefail

# Pre-push hook — Hatch era.
#
# NOTE: This project deploys to Hatch via source-upload (tar+curl), NOT via
# git push. A `git push` to GitHub does NOT trigger any deploy and does NOT
# touch the production database (which lives on a persistent Hatch volume at
# /files/shared.db and survives rollouts). So a raw push is SAFE — the old
# Railway-era "block all pushes" gate has been removed.
#
# The remaining check is a soft reminder to bump SITE_VERSION before pushing
# code intended for deploy. It only WARNS — it never blocks — because pushing
# docs/infra without a version bump is legitimate now that push != deploy.
# See DEPLOY.md for the real deploy procedure.

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

VERSION_FILE="server/version.ts"
[[ -f "$VERSION_FILE" ]] || exit 0

# Compare against the current branch's upstream, falling back to origin/HEAD.
UPSTREAM="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo '')"
[[ -n "$UPSTREAM" ]] || exit 0

extract_vals() {
  printf '%s' "$1" \
    | sed -n "s/^export const SITE_VERSION = '\([^']*\)'.*/\1/p" | head -n1
}

if ! git show "$UPSTREAM:$VERSION_FILE" >/dev/null 2>&1; then
  exit 0  # upstream file doesn't exist yet — nothing to compare
fi

local_ver=$(extract_vals "$(cat "$VERSION_FILE")")
remote_ver=$(extract_vals "$(git show "$UPSTREAM:$VERSION_FILE")")

if [[ "$local_ver" == "$remote_ver" ]]; then
  echo ""
  echo "⚠️  Note: SITE_VERSION ($local_ver) is unchanged vs $UPSTREAM."
  echo "   If these commits are headed for a deploy, bump SITE_VERSION/SITE_TIME"
  echo "   in $VERSION_FILE and add a src/changelog.ts entry first (see DEPLOY.md)."
  echo "   (Pushing anyway — this is only a reminder, not a block.)"
  echo ""
fi

exit 0
